# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boilerplate_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/boilerplate_db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production

# S3 / MinIO Storage Configuration
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=miniouser
S3_SECRET_KEY=miniopassword
S3_BUCKET_NAME=boilerplate-uploads
S3_SECURE=false

# Video crawler secret
CRAWLER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# LLM Configuration (Self-hosted or OpenAI-compatible, e.g. Google Gemini via OpenAI endpoint)
# To use Gemini:
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL_NAME=gemini-flash-lite-latest
LLM_API_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy-key
LLM_MODEL_NAME=default
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Embedding Configuration
EMBEDDING_API_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=dummy-key
EMBEDDING_MODEL_NAME=default-embed
EMBEDDING_DIMENSION=384
USE_LOCAL_FALLBACK=true
