# Application Config
APP_NAME="RAG Viral Video"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Self-Hosted LLM Config (OpenAI-compatible)
LLM_API_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="dummy-key"
LLM_MODEL_NAME="default"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Self-Hosted Embedding Config (OpenAI-compatible or custom)
EMBEDDING_API_BASE_URL="http://localhost:8000/v1"
EMBEDDING_API_KEY="dummy-key"
EMBEDDING_MODEL_NAME="default-embed"
EMBEDDING_DIMENSION=384

# Vector Store Config (ChromaDB)
CHROMA_PERSIST_DIR="./data/storage/chroma"
CHROMA_COLLECTION_NAME="viral_video_patterns"

# Feature Flags & Fallbacks
USE_LOCAL_FALLBACK=true
