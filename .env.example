# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boilerplate_db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-very-secure-secret-key-in-production

# S3 / MinIO Storage Configuration
S3_ENDPOINT=dutmakers3.dutai.io.vn
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET_NAME=video-rag
S3_SECURE=true

# Vector Store (PostgreSQL pgvector)
PGVECTOR_TABLE_NAME=viral_video_embeddings

# LLM Configuration (DUT AI Gemma 4)
LLM_API_BASE_URL=https://llm2.dutai.site/v1
LLM_API_KEY=
LLM_MODEL_NAME=ggml-org/gemma-4-e4b-it-GGUF:Q4_0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
USE_LOCAL_FALLBACK=true



# Text Embedding Configuration (DUT AI BAAI/bge-m3)
EMBEDDING_API_BASE_URL=https://textembedding.dutai.io.vn/v1
EMBEDDING_API_KEY=dutaiclb
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
USE_LOCAL_FALLBACK=true

# Text Reranker Configuration (DUT AI BAAI/bge-reranker-v2-m3)
RERANK_API_BASE_URL=https://textembedding.dutai.io.vn
RERANK_API_KEY=dutaiclb
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_CANDIDATE_K=15
RERANK_TOP_N=3
RERANK_TIMEOUT=15.0
RERANK_USE_FALLBACK=true
